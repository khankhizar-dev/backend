type Query {
    me: User!
    userDevices: [UserDevice!]!
}

type User {
    id: ID!
        email: String!
        firstName: String
        lastName: String
        fullName: String
        username: String
        phoneNumber: String
        dateOfBirth: String
        nationality: String
        profilePhotoUrl: String
        country: String
}

type UserDevice {
    id: ID!
    deviceName: String
    platform: String
    appVersion: String
    lastLoginAt: String
    createdAt: String!
}

input RegisterInput {
    email: String!
    password: String!
    firstName: String!
    lastName: String!
}

type AuthPayload {
    user: User!
    token: String!
    refreshToken: String!
}

type UserPreferences {
    currency: String!
    language: String!
    dateFormat: String!
    units: String!
    theme: String!
    timezone: String!
}

type Mutation {
    register(input: RegisterInput!): AuthPayload!
    login(email: String!, password: String!): AuthPayload!
}

input RefreshTokenInput {
    refreshToken: String!
}

input VerifyEmailOtpInput {
    email: String!
    otp: String!
}

input VerifyPasswordResetOtpInput {
    email: String!
    otp: String!
}

input ResetPasswordInput {
    email: String!
    otp: String!
    newPassword: String!
}

type RefreshTokenPayload {
    token: String!
    refreshToken: String!
}

extend type Mutation {
    refreshToken(input: RefreshTokenInput!): RefreshTokenPayload!
    logout: Boolean!
    logoutAllDevices: Boolean!
    changePassword(currentPassword: String!, newPassword: String!): Boolean!
    verifyEmailOtp(input: VerifyEmailOtpInput!): Boolean!
    resendEmailOtp: Boolean!
    requestPasswordReset(email: String!): Boolean!
    verifyPasswordResetOtp(input: VerifyPasswordResetOtpInput!): Boolean!
    resetPassword(input: ResetPasswordInput!): Boolean!
    updateProfile(input: UpdateProfileInput!): User!
    updatePreferences(input: UpdatePreferencesInput!): UserPreferences!
}

input UpdateProfileInput {
    firstName: String
    lastName: String
    username: String
    country: String
    phoneNumber: String
    dateOfBirth: String
    nationality: String
    profilePhotoUrl: String
}

input UpdatePreferencesInput {
    currency: String
    language: String
    dateFormat: String
    units: String
    theme: String
}

extend type Query {
    myPreferences: UserPreferences!
}

enum TripStatus {
    DRAFT
    UPCOMING
    IN_PROGRESS
    COMPLETED
    ARCHIVED
}

type Trip {
    id: ID!
    ownerId: ID!
    name: String!
    destination: String!
    startDate: String!
    endDate: String!
    status: TripStatus!
    progress: Int!
    travelers: Int!
    createdAt: String!
    updatedAt: String!
}

input CreateTripInput {
    name: String!
    destination: String!
    startDate: String!
    endDate: String!
}

input TripFilterInput {
    status: TripStatus
    search: String
}

extend type Query {
    trips(filter: TripFilterInput): [Trip!]!
    trip(id: ID!): Trip!
}

extend type Mutation {
    createTrip(input: CreateTripInput!): Trip!
    updateTrip(id: ID!, input: UpdateTripInput!): Trip!
    archiveTrip(id: ID!): Boolean!
    restoreTrip(id: ID!): Trip!
    deleteTrip(id: ID!): Boolean!
}

enum TripMemberRole {
    OWNER
    MEMBER
}

enum TripMemberStatus {
    PENDING
    ACCEPTED
    DECLINED
}

type TripMember {
    id: ID!
    tripId: ID!
    userId: ID!
    role: TripMemberRole!
    status: TripMemberStatus!
    invitedAt: String!
    joinedAt: String
}

input InviteTripMemberInput {
    email: String!
}

extend type Query {
    tripMembers(tripId: ID!): [TripMember!]!
}

extend type Mutation {
    inviteTripMember(
        tripId: ID!
        input: InviteTripMemberInput!
    ): TripMember!
}

extend type Mutation {
    acceptTripInvitation(tripId: ID!): TripMember!
    declineTripInvitation(tripId: ID!): TripMember!
}

extend type Query {
    myTripInvitations: [TripMember!]!
}

input UpdateTripInput {
    name: String
    destination: String
    startDate: String
    endDate: String
    status: TripStatus
}

type ItineraryDay {
    id: ID!
    tripId: ID!
    dayNumber: Int!
    date: String!
    title: String
    notes: String
    createdAt: String!
    updatedAt: String!
}

input CreateItineraryDayInput {
    dayNumber: Int!
    date: String!
    title: String
    notes: String
}

input UpdateItineraryDayInput {
    dayNumber: Int
    date: String
    title: String
    notes: String
}

extend type Query {
    itineraryDays(tripId: ID!): [ItineraryDay!]!
    itineraryDay(tripId: ID!, dayNumber: Int!): ItineraryDay!
}

extend type Mutation {
    createItineraryDay(
        tripId: ID!
        input: CreateItineraryDayInput!
    ): ItineraryDay!

    updateItineraryDay(
        tripId: ID!
        dayNumber: Int!
        input: UpdateItineraryDayInput!
    ): ItineraryDay!

    deleteItineraryDay(
        tripId: ID!
        dayNumber: Int!
    ): Boolean!
}

enum ActivityType {
    ACTIVITY
    MEAL
    TRANSPORT
    HOTEL
    FLIGHT
    TRAIN
    BUS
    EVENT
    SIGHTSEEING
    OTHER
}

type ItineraryActivity {
    id: ID!
    itineraryDayId: ID!
    title: String!
    description: String
    type: ActivityType!
    startTime: String
    endTime: String
    location: String
    latitude: Float
    longitude: Float
    sortOrder: Int!
    completed: Boolean!
    createdAt: String!
    updatedAt: String!
}

input CreateItineraryActivityInput {
    title: String!
    description: String
    type: ActivityType!
    startTime: String
    endTime: String
    location: String
    latitude: Float
    longitude: Float
    sortOrder: Int
}

input UpdateItineraryActivityInput {
    title: String
    description: String
    type: ActivityType
    startTime: String
    endTime: String
    location: String
    latitude: Float
    longitude: Float
    sortOrder: Int
    completed: Boolean
}

extend type Query {
    itineraryActivities(
        tripId: ID!
        itineraryDayId: ID!
    ): [ItineraryActivity!]!

    itineraryActivity(
        tripId: ID!
        itineraryDayId: ID!
        activityId: ID!
    ): ItineraryActivity!
}

extend type Mutation {
    createItineraryActivity(
        tripId: ID!
        itineraryDayId: ID!
        input: CreateItineraryActivityInput!
    ): ItineraryActivity!

    updateItineraryActivity(
        tripId: ID!
        itineraryDayId: ID!
        activityId: ID!
        input: UpdateItineraryActivityInput!
    ): ItineraryActivity!

    deleteItineraryActivity(
        tripId: ID!
        itineraryDayId: ID!
        activityId: ID!
    ): Boolean!

    markItineraryActivityCompleted(
        tripId: ID!
        itineraryDayId: ID!
        activityId: ID!
        completed: Boolean!
    ): ItineraryActivity!
}

enum BookingType {
    FLIGHT
    HOTEL
    TRAIN
    BUS
    CAR_RENTAL
    ACTIVITY
    RESTAURANT
    OTHER
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
    COMPLETED
    REFUNDED
    FAILED
}

enum BookingSource {
    MANUAL
    EMAIL
    PNR
    TICKET_SCAN
}

type Booking {
    id: ID!
    tripId: ID!
    itineraryDayId: ID
    createdBy: ID!

    type: BookingType!
    status: BookingStatus!

    title: String!
    provider: String
    bookingReference: String

    startAt: String
    endAt: String

    location: String

    amount: Float
    currency: String

    source: BookingSource!

    notes: String
    details: String

    createdAt: String!
    updatedAt: String!
}

type BookingTraveller {
    id: ID!
    bookingId: ID!

    firstName: String!
    lastName: String
    email: String
    phoneNumber: String
    dateOfBirth: String
    ticketNumber: String
    seatNumber: String

    createdAt: String!
    updatedAt: String!
}

type BookingEvent {
    id: ID!
    bookingId: ID!
    eventType: String!
    description: String
    metadata: String
    createdBy: ID
    createdAt: String!
}

input CreateBookingInput {
    itineraryDayId: ID
    type: BookingType!
    title: String!
    provider: String
    bookingReference: String
    startAt: String
    endAt: String
    location: String
    amount: Float
    currency: String
    notes: String
    details: String
}

input UpdateBookingInput {
    type: BookingType
    title: String
    provider: String
    bookingReference: String
    startAt: String
    endAt: String
    location: String
    amount: Float
    currency: String
    status: BookingStatus
    notes: String
    details: String
}

extend type Query {
    bookings(
            tripId: ID!
            filter: BookingFilterInput
        ): [Booking!]!

    booking(
        tripId: ID!
        bookingId: ID!
    ): Booking!

    bookingTravellers(
        tripId: ID!
        bookingId: ID!
    ): [BookingTraveller!]!

    bookingEvents(
        tripId: ID!
        bookingId: ID!
    ): [BookingEvent!]!
}

extend type Mutation {
    createBooking(
        tripId: ID!
        input: CreateBookingInput!
    ): Booking!

    updateBooking(
        tripId: ID!
        bookingId: ID!
        input: UpdateBookingInput!
    ): Booking!

    deleteBooking(
        tripId: ID!
        bookingId: ID!
    ): Boolean!
}

input CreateBookingTravellerInput {
    firstName: String!
    lastName: String
    email: String
    phoneNumber: String
    dateOfBirth: String
    ticketNumber: String
    seatNumber: String
}

input UpdateBookingTravellerInput {
    firstName: String
    lastName: String
    email: String
    phoneNumber: String
    dateOfBirth: String
    ticketNumber: String
    seatNumber: String
}

extend type Mutation {
    addBookingTraveller(
        tripId: ID!
        bookingId: ID!
        input: CreateBookingTravellerInput!
    ): BookingTraveller!

    updateBookingTraveller(
        tripId: ID!
        bookingId: ID!
        travellerId: ID!
        input: UpdateBookingTravellerInput!
    ): BookingTraveller!

    deleteBookingTraveller(
        tripId: ID!
        bookingId: ID!
        travellerId: ID!
    ): Boolean!
}

input BookingFilterInput {
    type: BookingType
    status: BookingStatus
    search: String
}
