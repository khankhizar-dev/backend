type Query {
    me: User!
    userDevices: [UserDevice!]!
}

type User {
    id: ID!
        email: String!
        firstName: String
        lastName: String
        fullName: String
        username: String
        phoneNumber: String
        dateOfBirth: String
        nationality: String
        profilePhotoUrl: String
        country: String
}

type UserDevice {
    id: ID!
    deviceName: String
    platform: String
    appVersion: String
    lastLoginAt: String
    createdAt: String!
}

input RegisterInput {
    email: String!
    password: String!
    firstName: String!
    lastName: String!
}

type AuthPayload {
    user: User!
    token: String!
    refreshToken: String!
}

type UserPreferences {
    currency: String!
    language: String!
    dateFormat: String!
    units: String!
    theme: String!
    timezone: String!
}

type Mutation {
    register(input: RegisterInput!): AuthPayload!
    login(email: String!, password: String!): AuthPayload!
}

input RefreshTokenInput {
    refreshToken: String!
}

input VerifyEmailOtpInput {
    email: String!
    otp: String!
}

input VerifyPasswordResetOtpInput {
    email: String!
    otp: String!
}

input ResetPasswordInput {
    email: String!
    otp: String!
    newPassword: String!
}

type RefreshTokenPayload {
    token: String!
    refreshToken: String!
}

extend type Mutation {
    refreshToken(input: RefreshTokenInput!): RefreshTokenPayload!
    logout: Boolean!
    logoutAllDevices: Boolean!
    changePassword(currentPassword: String!, newPassword: String!): Boolean!
    verifyEmailOtp(input: VerifyEmailOtpInput!): Boolean!
    resendEmailOtp: Boolean!
    requestPasswordReset(email: String!): Boolean!
    verifyPasswordResetOtp(input: VerifyPasswordResetOtpInput!): Boolean!
    resetPassword(input: ResetPasswordInput!): Boolean!
    updateProfile(input: UpdateProfileInput!): User!
    updatePreferences(input: UpdatePreferencesInput!): UserPreferences!
}

input UpdateProfileInput {
    firstName: String
    lastName: String
    username: String
    country: String
    phoneNumber: String
    dateOfBirth: String
    nationality: String
    profilePhotoUrl: String
}

input UpdatePreferencesInput {
    currency: String
    language: String
    dateFormat: String
    units: String
    theme: String
}

extend type Query {
    myPreferences: UserPreferences!
}
